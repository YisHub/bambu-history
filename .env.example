BAMBU_EMAIL=tu@email.com
BAMBU_PASSWORD=tupassword

# Puerto del visor. Es cosa de cada máquina: si el 8766 ya está ocupado en la
# tuya, poné otro acá y no hace falta tocar nada más.
VIEWER_PORT=8766

# Dónde deja los archivos. Vacío = /output y /data dentro de Docker, o ./output
# y ./data corriendo a mano. Solo hace falta tocarlo en casos raros.
#OUTPUT_DIR=./output
#DATA_DIR=./data

# Opcional: filtrar por impresora (vacío = todas las de tu cuenta).
# El serial está en la pantalla: Settings → Dispositivo → SN de la Impresora
BAMBU_DEVICE_ID=

# Cuántos trabajos traer
LIMIT=50

# Cards por página en el visor: "auto" llena la pantalla (columnas × filas que
# entran); un número lo fija. El paginador aparece solo si hay más de una página.
PAGE_SIZE=auto

# Calidad de las miniaturas WebP (1-100; 82 es el default, sin diferencia visible)
COVER_QUALITY=82

# Esfuerzo del compresor WebP (0-6). Medido acá: method=6 tarda 742 ms por imagen
# y method=4 tarda 21 ms, para ahorrar 0,1 KB. No subas esto sin medir.
#COVER_METHOD=4

# Descargas de miniaturas en paralelo. Es latencia de red, no CPU: subirlo ayuda
# en la primera corrida (cuando no hay nada en caché) y no hace nada después.
#COVER_WORKERS=8

# Genera además historial-portable.html: UN solo archivo con las miniaturas
# embebidas, que se abre con doble clic sin Docker ni servidor. Ojo: lleva
# adentro tus miniaturas y títulos reales, así que fijate a quién se lo pasás.
#PORTABLE=1

# Guardar JSON (1 = sí, 0 = no)
SAVE_JSON=1

# Modo live: el script sirve el HTTP y regenera al recargar la página.
# REFRESH_INTERVAL en segundos (0 = una sola corrida, sin loop).
#SERVE=1
#REFRESH_INTERVAL=300

# Auto-apagado del servicio `viewer` (0 = que quede prendido)
#VIEWER_TIMEOUT=30m
